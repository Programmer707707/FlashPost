
<!-- Header-->
<header class="py-5">
<!-- Page Content-->
<div class="container px-4 px-lg-5">
    <!-- Heading Row-->
   <div class="row gx-5 align-items-center my-5" style="background-color: #f8f9fa; border-radius: 15px; padding: 2rem;">
    <!-- Image Section -->
        <div class="col-lg-6 text-center">
            <img class="img-fluid rounded shadow-sm" src="./assets/banner1.jpg" alt="Banner" style="width: 100%; max-width: 600px; border-radius: 12px;">
        </div>

    <!-- Text Section -->
        <div class="col-lg-6 text-center text-lg-start">
            <h1 class="font-weight-bold mb-4" style="color: #333;">O'z e'loningizni joylashtiring</h1>
            <p class="text-muted" style="font-size: 1.1rem;">
                Bu sayt orqali siz o'z e'lonlaringizni bepul joylashtirib borishingiz mumkin. Istalgan kategoriyangizni tanlang va e'loningizni joylashtiring.
            </p>
            {{#if user}}
                <a class="btn btn-primary btn-lg px-4 rounded-pill mt-3" href="posters/add">E'lon joylashtirish</a>
            {{else}}
                <a class="btn btn-primary btn-lg px-4 rounded-pill mt-3" href="/auth/login">Tizimga kirish</a>
            {{/if}}
        </div>
    </div>




    <!-- Call to Action-->
    
   {{#if user}}
    <div class="card my-5 py-4 text-center shadow-sm border-0 rounded-4">
        <div class="card-body">
            <form class="row g-2 justify-content-center" action="/posters" method="GET">
                <div class="col-md-8">
                    <label for="search" class="visually-hidden">Qidiruv</label>
                    <input 
                        type="text" 
                        class="form-control form-control-lg rounded-pill" 
                        id="search" 
                        placeholder="E'lonlar qidiruvi..."
                        name="search"
                        >
                </div>
                <div class="col-auto">
                    <button type="submit" class="btn btn-primary btn-lg rounded-pill px-4">Izlash</button>
                </div>
            </form>
        </div>
    </div>

   {{/if}}

</header>
<!-- Page Content-->
<section class="pt-4">
    <div class="container px-lg-5">
        <!-- Page Features-->
    <div class="row gx-4 gy-4">
        <div class="col-md-6 col-lg-3 mb-5">
        <a href="/posters?category=realty" class="category-poster">
            <div class="card bg-light border-0 h-100">
                <div class="card-body text-center p-4 p-lg-5 pt-0 pt-lg-0">
                    <div class="feature bg-primary bg-gradient text-white rounded-3 mb-4 mt-n4"><i class="bi bi-house-door-fill"></i></div>
                    <h2 class="fs-4 fw-bold">Ko'chmas Mulk</h2>
                    <p class="mb-0">Ko'chmas mulk oldi sotdisi. Kvartiralar, uy sotib olish va sotish!</p>
                </div>
            </div>
        </a>
    </div>
    <div class="col-md-6 col-lg-3 mb-5">
        <a href="/posters?category=transport" class="category-poster">
            <div class="card bg-light border-0 h-100">
                <div class="card-body text-center p-4 p-lg-5 pt-0 pt-lg-0">
                    <div class="feature bg-primary bg-gradient text-white rounded-3 mb-4 mt-n4"><i class="bi bi-truck"></i></div>
                    <h2 class="fs-4 fw-bold">Transport</h2>
                    <p class="mb-0">Avtomobil oldi sotdisi va ijarasi.</p>
                </div>
            </div>
        </a>
    </div>
    <div class="col-md-6 col-lg-3 mb-5">
        <a href="/posters?category=electronics" class="category-poster">
            <div class="card bg-light border-0 h-100">
                <div class="card-body text-center p-4 p-lg-5 pt-0 pt-lg-0">
                    <div class="feature bg-primary bg-gradient text-white rounded-3 mb-4 mt-n4"><i class="bi bi-phone-fill"></i></div>
                    <h2 class="fs-4 fw-bold">Elektrotexnika</h2>
                    <p class="mb-0">Turli gadjetlar va mobil qurilmalar oldi sotdisi.</p>
                </div>
            </div>
        </a>
    </div>
    <div class="col-md-6 col-lg-3 mb-5">
        <a href="/posters?category=jobs" class="category-poster">
            <div class="card bg-light border-0 h-100">
                <div class="card-body text-center p-4 p-lg-5 pt-0 pt-lg-0">
                    <div class="feature bg-primary bg-gradient text-white rounded-3 mb-4 mt-n4"><i class="bi bi-person-lines-fill"></i></div>
                    <h2 class="fs-4 fw-bold">Ish o'rinlari</h2>
                    <p class="mb-0">Turli ish o'rinlari haqidagi e'lonlar to'plami</p>
                </div>
            </div>
        </a>
    </div>
</div>

    </div>
</section>
<div class="card text-white bg-primary my-5 py-4 text-center">
    <div class="card-body"><p class="text-white m-0 last-posters">Oxirgi joylangan e'lonlar</p></div>
</div>
<div class="container">
    <!-- Page Features-->
    <div class="row">
        <div class="col-lg-12">
            <div class="row">

                {{#if posters}}
                    {{#each posters}}   
                        <div class="col-lg-3 text-center mb-3">
                            <div class="card shadow-sm border-1 rounded-lg">
                                <a href="/posters/{{_id}}"><img src="{{url}}/{{image}}" class="card-img-top rounded-top img-fluid" style="height: 300px; object-fit: cover;" alt=""></a>
                                <div class="card-body d-flex flex-column">
                                    <div class="poster-title-cont">
                                        <a href="/posters/{{_id}}" class="poster-link text-dark text-decoration-none">
                                            <h5 class="card-title fw-bold">{{title}}</h5>
                                        </a>
                                    </div>
                                    <p class="card-text text-muted" style="margin: 0">{{region}}</p>
                                    <p class="card-text text-muted">- {{formatDate createdAt}}</p>
                                    <h5 class="card-subtitle text-primary fw-bold mt-auto">{{amount}} SO'M</h5>
                                </div>
                            </div>
                        </div>
                        {{/each}}
                {{else}}
                    <div class="col-lg-12 text-center">
                        <h3 class="fw-bold">E'lonlar mavjud emas</h3>
                    </div>
                {{/if}}
            </div>

            {{#if posters}}
                <div class="row">
                    <div class="col text-center my-4">
                        <a href="/posters" class="btn btn-outline-secondary btn-lg">
                            Barcha e'lonlar
                        </a>
                    </div>
                </div>
            {{/if}}
        </div>
    </div>
</div>
