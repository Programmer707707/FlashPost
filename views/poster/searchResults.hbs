
<div class="container mt-5">
<div class="card my-5 py-4 text-center border-0">
        
 <div class="card shadow-sm border-0 rounded-4 my-5 p-4">
    <div class="card-body">
        <form class="row g-3 align-items-end" action="/posters" method="GET">
            <!-- Search Input -->
            <div class="col-12 mb-3">
                <label for="search" class="visually-hidden">Qidiruv</label>
                <input 
                    type="text" 
                    class="form-control form-control-lg rounded-pill" 
                    id="search" 
                    placeholder="E'lonlar qidiruvi..."
                    name="search"
                    value="{{querySearch}}"
                    >
            </div>

            <!-- Filters Title -->
            <h3 class="mb-3">Filtrlash</h3>

            <!-- Category Filter -->
            <div class="col-md-4">
                <label for="category" class="form-label">Kategoriya</label>
                <select class="form-select rounded-pill" id="category" name="category">
                    <option selected disabled>Kategoriyani tanlang</option>
                    <option value="realty">Ko'chmas mulk</option>
                    <option value="transport">Transport</option>
                    <option value="electronics">Elektronika</option>
                    <option value="jobs">Ish o'rinlari</option>
                </select>
            </div>

            <!-- Price Filter -->
            <div class="col-md-4">
                <label for="price-range" class="form-label">Narxi</label>
                <div class="input-group">
                    <input name="from" type="number" id="price-min" class="form-control rounded-start" placeholder="dan">
                    <input name="to" type="number" id="price-max" class="form-control rounded-end" placeholder="gacha">
                </div>
            </div>

            <!-- Region Filter -->
            <div class="col-md-4">
                <label for="region" class="form-label">Hudud</label>
                <select class="form-select rounded-pill" id="region" name="region">
                    <option selected disabled>Hududni tanlang</option>
                    <option value="Toshkent">Toshkent</option>
                    <option value="Qarshi">Qarshi</option>
                    <option value="Buxoro">Buxoro</option>
                    <option value="Navoiy">Navoiy</option>
                    <option value="Andijon">Andijon</option>
                    <option value="Namangan">Namangan</option>
                    <option value="Farg'ona">Farg'ona</option>
                    <option value="Guliston">Guliston</option>
                    <option value="Termiz">Termiz</option>
                    <option value="Samarqand">Samarqand</option>
                    <option value="Xorazm">Xorazm</option>
                    <option value="Nukus">Nukus</option>
                </select>
            </div>

            <!-- Submit Button -->
            <div class="col-12 text-center mt-4">
                <button type="submit" class="btn btn-primary btn-lg rounded-pill px-4">Izlash</button>
            </div>
        </form>
    </div>
</div>


</div>
</div>
<hr>
</div>
<div class="container">
    <!-- Page Features-->
    <div class="row">
    <div class="col-lg-10 offset-lg-1">
        <div class="row">
            {{#if posters}}
                {{#each posters}}
                    <div class="card mb-3">
                        <div class="row g-0">
                            <div class="col-md-3">
                            <a href="/posters/{{_id}}"><img src="{{../url}}{{image}}" class="img-fluid rounded-start img-board" alt="..."></a>
                            </div>
                            <div class="col-md-9">
                            <div class="card-body flex-poster-body">
                                <div class="flex-poster-title">
                                <div class="title-item-one"><a href="/posters/{{_id}}" class="poster-link">
                                    <span class="card-title poster-title poster-link poster-flexible">{{title}}</span>
                                </a></div>
                                <h5 class="title-item-two">{{amount}}</h5>
                                </div>
                                <div><p class="card-text"><small class="text-muted">{{region}} - 11.07.2021 16:45</small></p></div>
                            </div>
                            </div>
                        </div>
                    </div>
                {{/each}}
            {{else}}
                <h2>E'lonlar mavjud emas</h2>
            {{/if}}
        </div>
    </div>
    </div>
</div>

