 <div class="container mt-5 mtt">
  <div class="row">
    <div class="container mb-5">
      <div class="row">
        <div class="col-lg-4">
          <div class="card">
            <img src="{{url}}assets/noAvatar.png" style="height: 100%;" alt="">
          </div>
        </div>         
        <div class="col-lg-8">
          <div class="row">
            <div class="card">
            {{#if userProfile}}
              <h3 class="poster-page-title">Foydalanuvchi haqida ma'lumot</h3>
              <h1 class="poster-page-amount mb-5">{{userProfile.username}}</h1>
              <h4>Qo'shimcha ma'lumotlar</h4>
              <hr>
              <div>
                <h5 class="">Username: <small class="text-primary">{{userProfile.username}}</small></h5>
                <h5 class="">Telefon: <small class="text-primary">{{userProfile.phone}}</small></h5>
                
              </div>
              <hr>
              <div class="d-flex justify-content-between">
                <p>ID: {{userProfile._id}}</p>
                <p>E'lonlar soni: {{userProfile.posters.length}}</p>
              </div>
            </div>
            {{/if}}
          </div>
        </div>
        {{#if isMe}}
        <a href="/profile/change" class="btn mt-3 btn-success">O'zgartirish</a>
        {{/if}}
      </div>
    </div>
  </div>
</div> <div class="card text-white bg-primary my-5 py-4 text-center">
    <div class="card-body"><p class="text-white m-0 last-posters">Foydalanuvchining oxirgi e'lonlari</p></div>
</div> <div class="container">
    <!-- Page Features-->
                  <div class="row">
                    <div class="col-lg-12">
                      <div class="row">
                  {{#if posters}}
                    {{#each posters}}
                      <div class="col-lg-3 col-md-6 mb-4 fade show">
                      <div class="card shadow-sm border-0 rounded m-auto fade show">
                        <!-- Image Section -->
                        <a href="/posters/{{_id}}">
                          <img 
                            src="{{url}}/{{image}}" 
                            class="card-img-top rounded-top" 
                            style="height: 250px; object-fit: cover;" 
                            alt="{{title}}">
                        </a>
                        <!-- Card Body Section -->
                        <div class="card-body text-center">
                          <!-- Title -->
                          <h5 class="fw-bold text-dark">
                            <a href="/posters/{{_id}}" class="text-decoration-none">{{title}}</a>
                          </h5>
                          <!-- Region and Date -->
                          <p class="text-muted small mb-1">{{region}}</p>
                          <p class="text-muted small">- {{formatDate createdAt}}</p>
                          <!-- Amount -->
                          <h5 class="text-success fw-bold">{{amount}} SO'M</h5>
                        </div>
                      </div>
                    </div>
                {{/each}}
               
                {{else}}
                    <h2>E'lonlar mavjud emas</h2>
                {{/if}}
               
            </div>
        </div>
    </div>
</div>